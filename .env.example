# Portfolio Server Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# JWT Authentication
JWT_SECRET="aura_portfolio_super_secure_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"

# Initial Admin Credentials (used during auto-seed if database is empty)
ADMIN_EMAIL="admin@auradesign.studio"
ADMIN_PASSWORD="StudioAdmin2026!"
ADMIN_NAME="Elena Rostova"

# Database Configuration (Optional: defaults to persistent JSON store if MongoDB Atlas URI not set)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/designer_portfolio?retryWrites=true&w=majority"

# Cloudflare R2 / S3 Object Storage Configuration
# (Optional: If not provided, the server securely stores uploaded media in the local filesystem ./uploads directory)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="designer-portfolio-media"
R2_PUBLIC_URL="https://pub-your-bucket-id.r2.dev"
